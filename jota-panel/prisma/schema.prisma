generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MISMA base de datos que jota-agency (misma DATABASE_URL). Esta app
  // solo LEE — el schema y las migraciones los administra jota-agency.
  // Por eso el build de jota-panel nunca corre "prisma db push".
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  empresa       String?
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  diagnosticos Diagnostico[]
}

model Diagnostico {
  id        String   @id @default(cuid())
  userId    String
  consulta  String
  resultado String?
  idioma    String   @default("es")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
