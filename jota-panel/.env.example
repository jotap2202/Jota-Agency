# === Copiá este archivo como .env y completá los valores ===

# La MISMA connection string que ya usa jota-agency (Neon/Supabase).
# Copiala tal cual de las variables de entorno de jota-agency en Vercel —
# este panel lee de la misma base, no crea una nueva.
DATABASE_URL="postgresql://usuario:password@host/basedatos?sslmode=require"

# La contraseña para entrar al panel. Elegí algo largo, solo la sabés vos.
PANEL_PASSWORD="cambia-esto-por-una-contraseña-larga"

# Secreto para firmar la sesión. Generalo con: openssl rand -hex 32
PANEL_SECRET="cambia-esto-por-un-secreto-largo"
