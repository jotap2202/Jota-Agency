# === Copiá este archivo como .env y completá los valores ===
#
# Este archivo es una PLANTILLA: nunca lleva valores reales. El archivo .env
# está en .gitignore y no se sube nunca a Git.
#
# Están todas las variables que el código lee de verdad. Si agregás una
# `process.env.LO_QUE_SEA` nueva, documentala acá.

# ---------------------------------------------------------------------------
#  Base
# ---------------------------------------------------------------------------

# Secreto de sesión. Generalo con:  npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Google OAuth (Google Cloud → Credenciales → ID de cliente OAuth, tipo Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google  (y el de tu dominio)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Base de datos Postgres (Neon o Supabase, plan gratis).
# Copiá la "connection string" de Neon. Usá la MISMA local y en Vercel.
# Ej: postgresql://usuario:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:password@host/basedatos?sslmode=require"

# En Vercel se setea sola. Localmente NO hace falta.
# AUTH_URL="https://tudominio.com"

# Quién entra al panel y al CEO Command Center, separados por coma.
# Si la definís, manda solo ella. Si la dejás vacía, entra el mail por defecto
# y la primera cuenta creada en el sitio (ver src/lib/admin.ts).
ADMIN_EMAILS=""

# URL canónica del sitio. Se usa en los emails, en el código del widget y en
# los links del panel. NO se deriva del request a propósito: si no, un deploy
# de preview se declararía canónico. Por defecto: https://jotaagency.org
SITIO_URL=""

# NODE_ENV la setea Next automáticamente (development / production).
# No hace falta definirla a mano.

# ---------------------------------------------------------------------------
#  Diagnóstico con IA (J) y 24/7 AI Agent
# ---------------------------------------------------------------------------

# Clave de la API de Anthropic (https://console.anthropic.com).
# La usan DOS cosas:
#   · /api/diagnostico — si falta, muestra un texto de ejemplo.
#   · el 24/7 AI Agent — si falta, NO responde: cada consulta se guarda y se
#     deriva al equipo con el mensaje de fallback. No se pierde nada, pero
#     tampoco contesta la IA.
ANTHROPIC_API_KEY=""

# Modelo del agente. Por defecto claude-opus-4-8.
# claude-sonnet-5 cuesta bastante menos por conversación (ver ARQUITECTURA §7).
AGENTE_MODELO=""

# ---------------------------------------------------------------------------
#  24/7 AI Agent — infraestructura
# ---------------------------------------------------------------------------

# Clave maestra para cifrar las credenciales de los clientes (Gmail, Calendar,
# Slack, CRM) con AES-256-GCM. Mínimo 32 caracteres. Generala con:
#   openssl rand -base64 48
# Sin esto NO se pueden guardar integraciones. Si la rotás, las credenciales
# guardadas dejan de poder descifrarse y hay que volver a cargarlas.
APP_ENCRYPTION_KEY=""

# Protege /api/agente/cron (seguimientos, bandeja de salida, recuperación).
# Vercel Cron manda este valor como Bearer token.
# Sin secreto, cualquiera puede disparar los seguimientos de todos los clientes.
CRON_SECRET=""

# Envío de email transaccional (https://resend.com). Es el remitente por
# defecto de Jota Agency; cada cliente puede tener el suyo, cargado cifrado
# desde el panel (Settings → Integraciones).
# Sin proveedor, los emails quedan en la bandeja de salida como "simulados":
# se ven completos en el panel, pero no salen.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
#  Solo para probar el envío real de email (npm run test:email-real)
# ---------------------------------------------------------------------------
#
# Tres candados, a propósito. Una sola variable se activa sin querer al copiar
# un .env de un lado a otro; con tres, y una nombrando la dirección exacta, no
# hay forma de mandarle un correo de prueba a un cliente real por accidente.
#
#   1. ALLOW_REAL_EMAIL_TEST=true     autorización explícita
#   2. TEST_EMAIL_RECIPIENT=vos@...   la ÚNICA dirección permitida
#   3. el flag --enviar en el comando
#
# Faltando cualquiera de los tres, el script corre en ensayo: arma el email,
# lo muestra entero y no lo despacha.
#
# NO las dejes puestas en producción.
ALLOW_REAL_EMAIL_TEST=""
TEST_EMAIL_RECIPIENT=""
