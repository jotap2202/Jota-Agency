generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Neon/Supabase). Usá la misma DATABASE_URL local y en producción.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  empresa       String?
  password      String? // solo para registro con email; null si entró con Google
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  diagnosticos Diagnostico[]
}

model Diagnostico {
  id        String   @id @default(cuid())
  userId    String
  consulta  String
  resultado String?
  idioma    String   @default("es")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Empresas a las que JOTA les quiere vender. No tienen nada que ver con
/// User: un User es alguien que se registró en la web por su cuenta; un
/// Prospecto es alguien a quien vamos a buscar nosotros.
model Prospecto {
  id       String  @id @default(cuid())
  empresa  String
  rubro    String
  ciudad   String?
  web      String?
  telefono String?
  contacto String? // nombre de la persona, cuando lo sepamos
  email    String?
  /// nuevo | contactado | reunion | cliente | descartado
  estado   String  @default("nuevo")
  notas    String?
  /// De dónde salió (búsqueda, referido, directorio…). Sirve para saber qué
  /// canal de prospección funciona.
  fuente   String?

  /// Cuándo volver a escribirle. Es lo que hace que el panel pueda decir
  /// "estos tenés que seguirlos hoy" en vez de mostrar una tabla plana.
  proximoContacto DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([proximoContacto])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
